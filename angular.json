{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "bfw-angular-pwa": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "node_modules/@sqlite.org/sqlite-wasm/dist"
              },
              {
                "glob": "sql-wasm.wasm",
                "input": "node_modules/sql.js/dist",
                "output": "assets"
              },
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss",
              "src/tailwind.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "optimization": true,
              "namedChunks": false,
              "extractLicenses": true,
              "sourceMap": false,
              "baseHref": "/",
              "fileReplacements": [
                {
                  "replace": "env/env.ts",
                  "with": "env/production.env.ts"
                }
              ],
              "serviceWorker": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "baseHref": "/",
              "fileReplacements": [
                {
                  "replace": "env/env.ts",
                  "with": "env/development.env.ts"
                }
              ]
            },
            "debug": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "baseHref": "/",
              "fileReplacements": [
                {
                  "replace": "env/env.ts",
                  "with": "env/debug.env.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "ssl": true,
            "sslKey": "ssl/localhost-key.pem",
            "sslCert": "ssl/localhost-crt.pem",
            "headers": {
              "cross-origin-opener-policy": "same-origin",
              "cross-origin-embedder-policy": "require-corp"
            },
            "prebundle": false
          },
          "configurations": {
            "production": {
              "buildTarget": "bfw-angular-pwa:build:production"
            },
            "development": {
              "buildTarget": "bfw-angular-pwa:build:development"
            },
            "debug": {
              "buildTarget": "bfw-angular-pwa:build:debug",
              "host": "0.0.0.0",
              "port": 20155
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  },
  "schematics": {
    
  }
}