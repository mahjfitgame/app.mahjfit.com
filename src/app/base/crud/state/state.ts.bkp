    // method ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
    public setPrimaryKey(key: string): void {
        this._primaryKey.set(key);
    }
    public setSecondaryKey(key: string): void {
