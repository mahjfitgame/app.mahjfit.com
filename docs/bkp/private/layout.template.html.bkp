  <mat-sidenav-container
    class="tw:min-h-dvh sidenav-container"
    [ngClass]="{
      'is-mobile': isMobile,
      'icon-sidebar-opened': iconicSidebar() && !isMobile && StartSideBar.opened,
      'icon-sidebar-closed': iconicSidebar() && !isMobile && !StartSideBar.opened
