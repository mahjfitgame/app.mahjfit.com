    <mat-sidenav #StartSideBar fixedInViewport position="start" [mode]="(isHandset$ | async) ? 'over' : 'side'" [attr.role]="(isHandset$ | async) ? 'dialog' : 'navigation'" [opened]="false" class="sidenav">
      <app-app-sidebar>
      <aside role="navigation">
        <header>
          <div class="tw:safe-area-pt tw:safe-area-pl tw:relative tw:z-10">
            <ng-container *ngTemplateOutlet="StartSidebarHeader"></ng-container>
          </div>
        </header>
        <section class="tw:safe-area-pl tw:flex-1">
          <ng-container *ngTemplateOutlet="StartSidebar"></ng-container>
        </section>
        <footer>
          <div class="tw:safe-area-pb tw:safe-area-pl tw:relative tw:z-10">
            <ng-container *ngTemplateOutlet="StartSidebarFooter"></ng-container>
          </div>
        </footer>
      </aside>
      </app-app-sidebar>
    </mat-sidenav> <!-- need to make it dynamic as per device [mode]="(isHandset$ | async) ? 'over' : 'side'" -->
