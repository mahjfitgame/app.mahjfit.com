                <form [formGroup]="loginForm" (ngSubmit)="onSubmit()" class="tw:space-y-3">
                    <mat-form-field appearance="outline" class="tw:w-full">
                        <mat-label>Username, Email or Mobile</mat-label>
                        <input
                        matInput
                        formControlName="email"
                        type="text"
                        placeholder="Enter your username, email or mobile"
                        />
                        <mat-icon matSuffix class="material-symbols-rounded">person_shield</mat-icon>
                    </mat-form-field>

                    <div class="tw:flex tw:gap-3 tw:items-center tw:justify-end">

                       <a
                            routerLink="/auth/signup"
                            class="tw:text-primary tw:text-sm tw:font-medium tw:no-underline tw:hover:underline"
                        >
                            Sign Up
                        </a>

                        <button
                            matButton="filled"
                            type="submit"
                            [disabled]="loginForm.invalid"
                        >
                            Next
                        </button>
                    </div>
                </form>

                
                <form [formGroup]="loginForm" (ngSubmit)="onSubmit()" class="tw:space-y-3">
                    <mat-form-field appearance="outline" class="tw:w-full">
                        <mat-label>Password</mat-label>
                        <input
                        matInput
                        formControlName="password"
                        [type]="hidePassword ? 'password' : 'text'"
                        placeholder="Enter your password"
                        />
                        <button
                        matIconButton
                        matSuffix
                        type="button"
                        (click)="hidePassword = !hidePassword"
                        >
                        <mat-icon class="material-symbols-rounded">
                            {{ hidePassword ? "visibility_off" : "visibility" }}
                        </mat-icon>
                        </button>
                    </mat-form-field>

                    <div class="tw:flex tw:items-center tw:justify-center">
                        <mat-checkbox class="tw:shrink-0">Remember me</mat-checkbox>
                    </div>

                    <div class="tw:flex tw:items-center tw:gap-3">
                        <a
                            routerLink="/auth/forgot-password"
                            class="tw:text-primary tw:text-sm tw:font-medium tw:no-underline tw:hover:underline"
                        >
                            Forgot Password?
                        </a>

                        <button
                            matButton="text"
                            type="button"
                            class="tw:ml-auto"
                        >
                            Back
                        </button>

                        <button
                            matButton="filled"
                            type="submit"
                            [disabled]="loginForm.invalid"
                        >
                            Next
                        </button>
                    </div>
                </form>

                <form [formGroup]="loginForm" (ngSubmit)="onSubmit()" class="tw:space-y-3">
                    <h2 class="tw:mb-1 tw:text-2xl tw:font-semibold tw:tracking-tight">
                        Verify your access
                    </h2>
                    <p class="tw:mb-6 tw:text-sm tw:text-(--mat-sys-on-surface-variant)">
                        Choose the option to proceed
                    </p>
                    <div class="tw:space-y-3">
                        <button
                            type="button"
                            matRipple
                            routerLink="/auth/employee"
                            class="
                                tw:flex tw:w-full tw:cursor-pointer tw:items-center tw:gap-3
                                tw:rounded-3xl 
                                tw:p-3 tw:text-left
                                tw:hover:bg-primary-container
                                tw:hover:text-primary
                                
                            "
                        >
                            <span class="tw:flex tw:size-10 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-lg">
                                <mat-icon class="material-symbols-rounded">person</mat-icon>
                            </span>

                            <span class="tw:min-w-0 tw:flex-1">
                                <span class="tw:block tw:text-base tw:font-semibold tw:leading-tight">
                                    Are you an employee?
                                </span>

                                <span class="tw:mt-1 tw:block tw:text-sm tw:font-normal">
                                    Proceed to make a significant progress
                                </span>
                            </span>

                            <mat-icon class="material-symbols-rounded tw:shrink-0">
                                chevron_right
                            </mat-icon>
                        </button>

                        <button
                            type="button"
                            matRipple
                            routerLink="/auth/admin"
                            class="
                                tw:flex tw:w-full tw:cursor-pointer tw:items-center tw:gap-3
                                tw:rounded-3xl 
                                tw:p-3 tw:text-left 
                                tw:hover:bg-primary-container
                                tw:hover:text-primary
                                
                            "
                        >
                            <span class="tw:flex tw:size-10 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-lg">
                                <mat-icon class="material-symbols-rounded">manage_accounts</mat-icon>
                            </span>

                            <span class="tw:min-w-0 tw:flex-1">
                                <span class="tw:block tw:text-base tw:font-semibold tw:leading-tight">
                                    Are you an admin?
                                </span>

                                <span class="tw:mt-1 tw:block tw:text-sm tw:font-normal">
                                    Proceed to manage customer base
                                </span>
                            </span>

                            <mat-icon class="material-symbols-rounded tw:shrink-0">
                                chevron_right
                            </mat-icon>
                        </button>
                    </div>
                    <div class="tw:flex tw:items-center tw:justify-end">
                        <button
                            matButton="text"
                            type="submit"
                            class=""
                        >
                            Back
                        </button>

                        
                    </div>
                </form>

                <form [formGroup]="loginForm" (ngSubmit)="onSubmit()" class="tw:space-y-3">
                    <mat-form-field appearance="outline" class="tw:w-full">
                        <mat-label>OTP</mat-label>
                        <input
                        matInput
                        formControlName="password"
                        [type]="hidePassword ? 'password' : 'text'"
                        placeholder="Enter OTP"
                        />
                        <button
                        matIconButton
                        matSuffix
                        type="button"
                        (click)="hidePassword = !hidePassword"
                        >
                        <mat-icon class="material-symbols-rounded">
                            {{ hidePassword ? "visibility_off" : "visibility" }}
                        </mat-icon>
                        </button>
                    </mat-form-field>

                    <div class="tw:flex tw:items-center tw:gap-3">
                        <a
                            routerLink="/auth/forgot-password"
                            class="tw:text-primary tw:text-sm tw:font-medium tw:no-underline tw:hover:underline"
                        >
                            Resend OTP?
                        </a>

                        <button
                            matButton="text"
                            type="button"
                            class="tw:ml-auto"
                        >
                            Back
                        </button>

                        <button
                            matButton="filled"
                            type="submit"
                            [disabled]="loginForm.invalid"
                        >
                            Next
                        </button>
                    </div>
                </form>
            </mat-card-content>
        </mat-card>

        <!-- TODO: OAuth based signin option is future implementation -->
        
        <div class="tw:flex tw:mb-3 tw:items-center tw:gap-3">
            <hr class="tw:flex-1 tw:border-black/10 tw:dark:border-white/10">
            <p class="tw:shrink-0 tw:text-sm tw:text-secondary">OR continue with</p>
            <hr class="tw:flex-1 tw:border-black/10 tw:dark:border-white/10" />
        </div>

        <div class="tw:flex tw:justify-center tw:items-center tw:gap-4">
            <button matIconButton type="button">
                <img src="assets/g-logo.png" alt="Google" />
            </button>
            <button matIconButton type="button">
                <img src="assets/f-logo.png" alt="Facebook" />
            </button>
        </div>
        
    </div>
</div>