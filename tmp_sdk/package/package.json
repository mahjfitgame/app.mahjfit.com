{
  "name": "@bfw/api-sdk",
  "version": "1.0.0",
  "description": "Universal REST + GraphQL SDK (Node/Nest/Express/React/Angular)",
  "type": "module",
  "main": "./dist/index.js", 
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "dist/core/index.d.ts"
      ],
      "graphql": [
        "dist/graphql/index.d.ts"
      ],
      "graphql/libs": [
        "dist/graphql/libs/index.d.ts"
      ],
      "graphql/libs/*": [
        "dist/graphql/libs/*.d.ts"
      ],
      "graphql/endpoints": [
        "dist/graphql/endpoints/index.d.ts"
      ],
      "graphql/endpoints/shared": [
        "dist/graphql/endpoints/shared/index.d.ts"
      ],
      "graphql/endpoints/business": [
        "dist/graphql/endpoints/business/index.d.ts"
      ],
      "rest": [
        "dist/rest/index.d.ts"
      ],
      "rest/libs": [
        "dist/rest/libs/index.d.ts"
      ],
      "rest/libs/*": [
        "dist/rest/libs/*.d.ts"
      ],
      "rest/endpoints": [
        "dist/rest/endpoints/index.d.ts"
      ],
      "ws": [
        "dist/ws/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./graphql": {
      "types": "./dist/graphql/index.d.ts",
      "import": "./dist/graphql/index.js",
      "default": "./dist/graphql/index.js"
    },
    "./graphql/libs": {
      "types": "./dist/graphql/libs/index.d.ts",
      "import": "./dist/graphql/libs/index.js",
      "default": "./dist/graphql/libs/index.js"
    },
    "./graphql/libs/*": {
      "types": "./dist/graphql/libs/*.d.ts",
      "import": "./dist/graphql/libs/*.js",
      "default": "./dist/graphql/libs/*.js"
    },
    "./graphql/endpoints": {
      "types": "./dist/graphql/endpoints/index.d.ts",
      "import": "./dist/graphql/endpoints/index.js",
      "default": "./dist/graphql/endpoints/index.js"
    },
    "./graphql/endpoints/shared": {
      "types": "./dist/graphql/endpoints/shared/index.d.ts",
      "import": "./dist/graphql/endpoints/shared/index.js",
      "default": "./dist/graphql/endpoints/shared/index.js"
    },
    "./graphql/endpoints/business": {
      "types": "./dist/graphql/endpoints/business/index.d.ts",
      "import": "./dist/graphql/endpoints/business/index.js",
      "default": "./dist/graphql/endpoints/business/index.js"
    },
    "./rest": {
      "types": "./dist/rest/index.d.ts",
      "import": "./dist/rest/index.js",
      "default": "./dist/rest/index.js"
    },
    "./rest/libs": {
      "types": "./dist/rest/libs/index.d.ts",
      "import": "./dist/rest/libs/index.js",
      "default": "./dist/rest/libs/index.js"
    },
    "./rest/libs/*": {
      "types": "./dist/rest/libs/*.d.ts",
      "import": "./dist/rest/libs/*.js",
      "default": "./dist/rest/libs/*.js"
    },
    "./rest/endpoints": {
      "types": "./dist/rest/endpoints/index.d.ts",
      "import": "./dist/rest/endpoints/index.js",
      "default": "./dist/rest/endpoints/index.js"
    },
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "import": "./dist/ws/index.js",
      "default": "./dist/ws/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "tsx --test tests/bfw-sdk-response.test.ts",
    "build:origin": "tsup --config tsup.config.ts",
    "build:watch": "tsup --config tsup.config.ts --watch",
    "clean": "rimraf dist .build",
    "build:code": "node --import tsx tools/generate-build-src.ts",
    "build:dist": "tsup --config tsup.build.config.ts",
    "build": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=17000 npm run build:code && cross-env NODE_OPTIONS=--max-old-space-size=17000 npm run build:dist",
    "start": "tsx watch src/index.ts",
    "dev": "tsx src/index.ts",
    "debug": "tsx --watch src/index.ts",
    "trial": "tsx --watch trial.mjs",
    "lint": "echo \"(add eslint if you want)\"",
    "schema:sync:graph": "node src/graphql/endpoints/graph/schema-sync.mjs",
    "gpush": "git add . && git commit && git push origin",
    "gpull": "git fetch && git pull origin"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json",
    "manual.md"
  ],
  "keywords": [],
  "author": "N Parmar - Thats End",
  "license": "ISC",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-morph": "^27.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "path": "^0.12.7",
    "socket.io-client": "^4.8.3",
    "uuidv7": "^1.1.0"
  }
}
